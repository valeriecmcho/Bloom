# PayMongo Secret Key — get it from https://dashboard.paymongo.com/developers
# Use test key (sk_test_...) for development, live key (sk_live_...) for production
PAYMONGO_SECRET_KEY=sk_test_REPLACE_WITH_YOUR_KEY

# PayMongo Public Key — used on the frontend if needed
PAYMONGO_PUBLIC_KEY=pk_test_REPLACE_WITH_YOUR_KEY

